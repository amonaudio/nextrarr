<?xml version="1.0"?>
<Container version="2">
  <Name>nextrarr</Name>
  <Repository>amonaudio/nextrarr:latest</Repository>
  <Registry>https://hub.docker.com/r/amonaudio/nextrarr</Registry>
  <!--
    [0.7.12-xml-fix] Use <Network> (singular) — NOT <Networking> — to
    preselect the Network Type dropdown in Unraid's Add Container UI.
    The previous <Networking>bridge</Networking> was silently ignored
    by Community Applications, so the dropdown defaulted to "none"
    on some Unraid versions → no port forwarding → WebUI unreachable.
    Confirmed against the Unraid CA template spec (selfhosters.net):
    the singular <Network> is the official element, <Networking> with
    nested <Mode> is an auto-generated legacy form that gets stripped
    when the template is "cleaned" by the CA portal.
  -->
  <Network>bridge</Network>
  <Shell>sh</Shell>
  <Privileged>false</Privileged>
  <Support>https://github.com/amonaudio/nextrarr/issues</Support>
  <Project>https://github.com/amonaudio/nextrarr</Project>
  <Overview>nEXTrarr — Radarr/Sonarr metadata completion tool (themes, trailers, artwork) built with Next.js 16.</Overview>
  <Category>MediaTools:MediaServer</Category>
  <WebUI>http://[IP]:[PORT:3000]</WebUI>
  <TemplateURL>https://raw.githubusercontent.com/amonaudio/nextrarr/main/unraid/extrarr.xml</TemplateURL>
  <Icon>https://raw.githubusercontent.com/amonaudio/nextrarr/main/unraid/icon.png</Icon>
  <ExtraParams>--restart=unless-stopped</ExtraParams>
  <Date>2026-10-25</Date>

  <Config Name="Port: Web Interface" Target="3000" Default="3000" Mode="tcp" Description="Web UI port for nEXTrarr" Type="Port" Display="always" Required="true" Mask="false">3000</Config>
  <Config Name="Path: App Data" Target="/config" Default="/mnt/user/appdata/nextrarr" Mode="rw" Description="Persistent settings + SQLite database" Type="Path" Display="always" Required="true" Mask="false">/mnt/user/appdata/nextrarr</Config>
  <!--
    [0.7.12] Media Root pre-filled to /mnt/user/media (was /mnt/user before).
    /mnt/user/media is the most common Unraid share name for media libraries
    (Movies, TV, Music subfolders). Pre-filling this avoids accidentally
    exposing the entire /mnt/user tree to the container (better security
    default). The user can still change it to their actual media share.
  -->
  <Config Name="Path: Media Root" Target="/mnt/user" Default="/mnt/user/media/" Mode="rw" Description="Host media root (read-write for theme.mp3 + artwork + NFO). Default to /mnt/user/media — change to your actual media share if different." Type="Path" Display="always" Required="true" Mask="false">/mnt/user/media</Config>
  <Config Name="Variable: Allowed Prefixes" Target="EXTRARR_ALLOWED_PREFIXES" Default="/mnt,/data/media" Description="Comma-separated allowed path prefixes (security: app can only read/write files under these prefixes)" Type="Variable" Display="always" Required="false" Mask="false">/mnt,/data/media</Config>
  <Config Name="Variable: Log Level" Target="EXTRARR_LOG_LEVEL" Default="INFO" Description="DEBUG, INFO, WARNING, ERROR" Type="Variable" Display="always" Required="false" Mask="false">INFO</Config>
  <Config Name="Variable: Demo Mode" Target="EXTRARR_DEMO_MODE" Default="" Description="Set to 1 for mock data (no real Radarr/Sonarr connection)" Type="Variable" Display="always" Required="false" Mask="false"></Config>
</Container>
